# ============================================================
# AlphaCouncil environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ---- Application ----
ALPHACOUNCIL_ENV=development
ALPHACOUNCIL_LOG_LEVEL=INFO
ALPHACOUNCIL_API_HOST=0.0.0.0
ALPHACOUNCIL_API_PORT=8000

# ---- LLM providers ----
# Supported: openai | anthropic | deepseek | azure_openai
ALPHACOUNCIL_LLM_PROVIDER=openai
ALPHACOUNCIL_LLM_MODEL=gpt-4o-mini
ALPHACOUNCIL_LLM_TEMPERATURE=0.0
ALPHACOUNCIL_LLM_MAX_TOKENS=4096

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ---- Embedding ----
# Local (recommended, no API cost): BAAI/bge-m3
# Or an API provider name.
ALPHACOUNCIL_EMBEDDING_MODEL=BAAI/bge-m3
ALPHACOUNCIL_EMBEDDING_DIM=1024
ALPHACOUNCIL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- Vector store (Qdrant) ----
ALPHACOUNCIL_QDRANT_URL=http://localhost:6333
ALPHACOUNCIL_QDRANT_API_KEY=
ALPHACOUNCIL_QDRANT_COLLECTION=alphacouncil_docs

# ---- Relational store ----
# Used for structured financial data and Text-to-SQL.
ALPHACOUNCIL_DATABASE_URL=postgresql+asyncpg://alphacouncil:alphacouncil@localhost:5432/alphacouncil

# ---- Observability (Langfuse) ----
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- Agent runtime guards (cost and loop protection) ----
ALPHACOUNCIL_MAX_AGENT_STEPS=25
ALPHACOUNCIL_MAX_COST_USD_PER_RUN=0.50
ALPHACOUNCIL_REQUEST_TIMEOUT_SECONDS=120

# ---- Retrieval tuning ----
ALPHACOUNCIL_RECALL_TOP_K=50
ALPHACOUNCIL_RERANK_TOP_K=8
ALPHACOUNCIL_ENABLE_GRAPH_RETRIEVAL=true
ALPHACOUNCIL_ENABLE_TEXT2SQL=true
