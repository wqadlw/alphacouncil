# ============================================================
# AlphaCouncil environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ---- Application ----
ALPHACOUNCIL_ENV=development
ALPHACOUNCIL_LOG_LEVEL=INFO
ALPHACOUNCIL_API_HOST=0.0.0.0
ALPHACOUNCIL_API_PORT=8000

# ---- LLM providers ----
# Supported: openai | anthropic | deepseek | azure_openai
ALPHACOUNCIL_LLM_PROVIDER=openai
ALPHACOUNCIL_LLM_MODEL=gpt-4o-mini
ALPHACOUNCIL_LLM_TEMPERATURE=0.0
ALPHACOUNCIL_LLM_MAX_TOKENS=4096

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ---- Database (SQLite) ----
# Defaults to %LOCALAPPDATA%\AlphaCouncil\alphacouncil.db (constitution 5.3).
# Set only to point the app somewhere else; tests set it automatically.
# ALPHACOUNCIL_DATABASE_PATH=C:\somewhere\alphacouncil.db

# ---- Agent runtime guards (cost and loop protection) ----
ALPHACOUNCIL_MAX_AGENT_STEPS=25
ALPHACOUNCIL_MAX_COST_USD_PER_RUN=0.50
ALPHACOUNCIL_REQUEST_TIMEOUT_SECONDS=120
