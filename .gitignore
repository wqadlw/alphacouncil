.pnpm-store/

# ---- Data / artifacts (never commit local data or indexes) ----
data/
# ⚠️ `data/` above has no leading slash, so git matches it at ANY depth — which
# silently swallowed `frontend/src/components/data/` (spec 025's `DataTable.tsx`,
# a core source file) the first time it was created. `git add -A` reported
# success and `git status` showed a clean staged set; the file was simply absent
# from it. Cloning that commit would have failed the frontend build.
#
# Same trap as `.ai/checks/data/` below, and the same fix. Every new source
# directory named `data` needs its own negation here.
!frontend/src/components/data/
*.sqlite
*.sqlite3
*.db
indexes/
qdrant_storage/
*.parquet
*.csv
!tests/**/fixtures/*.csv

# ---- Observability / logs ----
logs/
*.log
langfuse/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Exceptions: `.ai/` directories that share a name with an artefact pattern ----
# `logs/` and `data/` above are meant for *runtime* output. Two directories under
# `.ai/` carry the same names but are source, and were being silently excluded:
#
#   .ai/logs/        the change ledger — "the development process is itself a
#                    deliverable" (constitution 10.4). Losing it on a fresh clone
#                    removes the record of how the project was built.
#   .ai/checks/data/ the runtime-scan rule directory (constitution 12 requires
#                    `.ai/checks/` to be split into `data/` and `static/`).
#
# A later rule overrides an earlier one, so these must stay at the end.
!.ai/logs/
!.ai/checks/data/

# Playwright test artifacts
test-results/
playwright-report/
